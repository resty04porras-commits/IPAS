# .env.example - production defaults for IPAS
# Session secret for cookie encryption
# REQUIRED in production. Generate with:
# powershell -NoProfile -Command "[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))"
SESSION_SECRET=

# Server Configuration for Domain Access
# Domain: iictdasset.lbfinc.org
# Port: 3000 (HTTP - not secured yet)
# Access URL: http://iictdasset.lbfinc.org:3000
# Run `npm run setup:domain` as Administrator to map the domain on Windows.
BIND_HOST=0.0.0.0
PUBLIC_HOST=iictdasset.lbfinc.org
PORT=3000
NODE_ENV=production
PADDLE_OCR_PYTHON=
OCR_ENGINE=easyocr
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_SERVICE_TIMEOUT_MS=180000
OCR_SERVICE_AUTO_START=true
OCR_SERVICE_STARTUP_PROBE_TIMEOUT_MS=120000
OCR_SERVICE_PROBE_TIMEOUT_MS=5000
OCR_SERVICE_PYTHON=
OCR_LANG=en
OCR_MIN_CONFIDENCE=0.70
OCR_USE_ANGLE_CLS=true

# Nextcloud Configuration
NEXTCLOUD_URL=https://nextcloud.lbfinc.org
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Email Notification Configuration (Gmail SMTP)
# Note: EMAIL_PASS must be a Gmail App Password if 2-Step Verification is enabled.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Gemini API Key (Pre-configured in AI Studio preview)
GEMINI_API_KEY=

# Development-only Vite HMR port. Not required by the production service.
# HMR_PORT=24678

# Mobile Access Setup:
# 1. Server must be accessible at iictdasset.lbfinc.org on your local network
# 2. Update your device's hosts file to point iictdasset.lbfinc.org to the server IP
# 3. Or access directly using http://<server-ip>:3000 from mobile browser
# EasyOCR:
# - First OCR run downloads the official English detection/recognition models once (to ~/.EasyOCR/)
# - Set OCR_SERVICE_PYTHON only if you need to override the default Python launcher
# - Set OCR_ENGINE=easyocr to use the Python FastAPI service in ocr-service/ (paddle is still accepted for compatibility)
# - Set OCR_ENGINE=legacy or run npm run dev:legacy to use the old Node worker path
# - OCR_SERVICE_AUTO_START=true lets the Node backend start ocr-service/.venv automatically
# - If the Python service fails, the Node backend falls back to the existing worker

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ipas_db
DB_USER=ipas_app
DB_PASSWORD=
