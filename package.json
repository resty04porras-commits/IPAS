{
  "name": "ipas",
  "private": true,
  "version": "1.0.0",
  "description": "IICTD Process Automation System (IPAS)",
  "author": "IICTD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "set NODE_ENV=development&& set OCR_ENGINE=easyocr&& set BIND_HOST=0.0.0.0&& set PORT=3000&& tsx server.ts",
    "dev:legacy": "set NODE_ENV=development&& set OCR_ENGINE=legacy&& set BIND_HOST=0.0.0.0&& set PORT=3000&& tsx server.ts",
    "dev:domain": "set NODE_ENV=development&& set OCR_ENGINE=easyocr&& set BIND_HOST=0.0.0.0&& set PUBLIC_HOST=iictdasset.lbfinc.org&& set DISABLE_HMR=true&& set PORT=3000&& tsx server.ts",
    "dev:domain-root": "set NODE_ENV=development&& set OCR_ENGINE=easyocr&& set BIND_HOST=0.0.0.0&& set PUBLIC_HOST=iictdasset.lbfinc.org&& set DISABLE_HMR=true&& set PORT=80&& set STRICT_PORT=true&& tsx server.ts",
    "start": "node tools/start-production.mjs",
    "start:domain": "node tools/start-production.mjs",
    "start:domain-root": "set PORT=80&& set STRICT_PORT=true&& node tools/start-production.mjs",
    "serve:ipas": "node tools/start-production.mjs",
    "setup:ipas": "powershell -ExecutionPolicy Bypass -File .\\tools\\setup-dev-domain.ps1 -Hostname iictdasset.lbfinc.org -Port 3000",
    "setup:ipas-root": "powershell -ExecutionPolicy Bypass -File .\\tools\\setup-dev-domain.ps1 -Hostname iictdasset.lbfinc.org -Port 80",
    "open:ipas": "powershell -ExecutionPolicy Bypass -File .\\tools\\open-domain-dev.ps1 -Hostname iictdasset.lbfinc.org -Port 3000",
    "setup:domain": "powershell -ExecutionPolicy Bypass -File .\\tools\\setup-dev-domain.ps1 -Hostname iictdasset.lbfinc.org -Port 3000",
    "setup:domain-root": "powershell -ExecutionPolicy Bypass -File .\\tools\\setup-dev-domain.ps1 -Hostname iictdasset.lbfinc.org -Port 80",
    "open:domain": "powershell -ExecutionPolicy Bypass -File .\\tools\\open-domain-dev.ps1 -Hostname iictdasset.lbfinc.org -Port 3000",
    "open:domain-root": "powershell -ExecutionPolicy Bypass -File .\\tools\\open-domain-dev.ps1 -Hostname iictdasset.lbfinc.org -Port 80",
    "build": "npm run build:web && npm run build:server",
    "build:web": "node tools/build-web.mjs",
    "build:start": "npm run build && npm run serve:ipas",
    "preview": "sh ./run-web-app.sh",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "ocr:install": "python -m pip install -r .\\tools\\requirements-paddleocr.txt",
    "ocr:service": "cd ocr-service && .\\.venv\\Scripts\\python.exe -m uvicorn ocr_api:app --host 127.0.0.1 --port 8001",
    "mobile:start": "npm run start:lan --prefix mobile",
    "mobile:install": "npm install --prefix mobile",
    "mobile:android": "npx expo run:android",
    "mobile:prebuild:android": "npx expo prebuild --platform android",
    "electron:dev": "electron .",
    "electron:build": "electron-builder build --win",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/server.cjs --external:vite --external:@vitejs/plugin-react --external:@tailwindcss/vite",
    "build:all": "powershell -ExecutionPolicy Bypass -File .\\build-all.ps1",
    "publish:vm": "powershell -ExecutionPolicy Bypass -File ./publish-to-vm.ps1",
    "publish:proxmox": "powershell -ExecutionPolicy Bypass -File ./publish-to-proxmox-vm.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "webdav": "^5.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "autoprefixer": "^10.4.21",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "expo-root-proxy": "file:tools/expo-proxy",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
